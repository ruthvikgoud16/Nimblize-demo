# Nimblize - Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to Git.

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nimblize:nimblize_dev@localhost:5432/nimblize
POSTGRES_PASSWORD=nimblize_dev

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Notifications ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/X000
SENDGRID_API_KEY=SG...
PAGERDUTY_ROUTING_KEY=...

# ─── Telemetry ────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ─── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=nimblize_admin

# ─── App ──────────────────────────────────────────────────────────────────
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://app.nimblize.ai

# ─── Phase 7 Search Console and Ahrefs ────────────────────────────────────
# Copy into .env. Never commit the filled file.
SEO_GSC_SITE_URL=sc-domain:nimblize.ai
SEO_GSC_CLIENT_ID=
SEO_GSC_CLIENT_SECRET=
SEO_GSC_REFRESH_TOKEN=
SEO_GSC_REDIRECT_URI=http://127.0.0.1:8765/
SEO_AHREFS_KEYWORDS_CSV=
SEO_AHREFS_REFERRING_DOMAINS_CSV=
